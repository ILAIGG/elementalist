[gd_scene format=3]

[ext_resource type="Script" path="res://Scripts/UI/RunCompleted.cs" id="1_run_completed"]

[node name="RunCompleted" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_run_completed")

[node name="Overlay" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.8)

[node name="UIContainer" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -180.0
offset_top = -100.0
offset_right = 180.0
offset_bottom = 100.0
grow_horizontal = 2
grow_vertical = 2

[node name="Title" type="Label" parent="UIContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 48
text = "Run Completed"
horizontal_alignment = 1

[node name="HSeparator" type="HSeparator" parent="UIContainer"]
layout_mode = 2

[node name="Panel" type="PanelContainer" parent="UIContainer"]
layout_mode = 2

[node name="Margin" type="MarginContainer" parent="UIContainer/Panel"]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 12

[node name="Content" type="VBoxContainer" parent="UIContainer/Panel/Margin"]
layout_mode = 2

[node name="Message" type="Label" parent="UIContainer/Panel/Margin/Content"]
layout_mode = 2
text = "You completed the run."
horizontal_alignment = 1

[node name="MainMenuButton" type="Button" parent="UIContainer/Panel/Margin/Content"]
layout_mode = 2
text = "Main Menu"
